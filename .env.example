# Copie para .env e preencha. NUNCA suba o .env para o GitHub.
# RPC da Sepolia (Alchemy/Infura ou público)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Chave privada de uma carteira SÓ DE TESTE (MetaMask > Detalhes da conta > Mostrar chave privada)
PRIVATE_KEY=0x...
# Opcional: verificação automática do código no Etherscan (etherscan.io/myapikey)
ETHERSCAN_API_KEY=
# Opcional: tesouraria diferente do deployer
TREASURY_ADDRESS=
